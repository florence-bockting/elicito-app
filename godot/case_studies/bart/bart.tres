[sub_resource type="Resource" id="Resource_5a2fq"]
script = ExtResource("2_target")
name = "omega"
title = "Planned pumps ω"
question = "How many pumps does the participant plan to make in a trial based on their risk attitude?"
unit = "planned pumps ω"

[sub_resource type="Resource" id="Resource_ircif"]
script = ExtResource("2_target")
name = "pumps"
title = "Actual pumps m"
question = "How many times will the participant pump, either because they stop or the balloon pops? How much does a participant stick to their plan?"
unit = "pumps in one trial"
axis_min = -0.5
axis_max = 20.5
discrete = true

[resource]
script = ExtResource("1_case")
id = "bart"
title = "Balloon Analogue Risk Task"
summary = "How much risk do people take for money? Experts describe participants of the balloon task, and elicito turns that into priors for risk propensity and consistency."
thumbnail = ExtResource("8_thumb")
docs_url = "https://elicito.readthedocs.io/en/latest/case-studies/bart-risk-taking/"
intro = "[b]Scenario[/b]
A participant inflates a virtual balloon one pump at a time. Each pump earns {reward}, but also pops the balloon with a chance of {burst}. When the balloon pops, the participant loses the money earned in that trial. They can stop at any time and bank their earnings.

[b]Elicitation task[/b]
Before seeing any data, we state what we expect a participant to do in this task. To make this easier, the [color=#a8540f]Training personas[/color] tab introduced three personas (Mila, Sam and Jonas) and the two questions we use to express our expectations: the [color=#a8540f]planned pumps[/color], which depend on the participant's risk attitude, and the [color=#a8540f]actual pumps[/color], which also depend on how consistently they follow their plan. We answer both with a roulette task: you spread chips over the possible numbers of pumps to show how likely you find each one."
model_text = "[font_size=21][b][color=#1f2a44]The case study: Balloon Analogue Risk Task (BART)[/color][/b][/font_size]
In the BART, a participant inflates a virtual balloon one pump at a time. Every pump adds money to a temporary bank, but every pump can also pop the balloon, with probability [color=#a8540f]p = 0.15[/color]. A popped balloon loses that trial's money. At any point the participant can stop and cash in, so the task measures how much risk people take. We use the cognitive model of Lee and Wagenmakers (2013, [i]Bayesian Cognitive Modeling[/i]), as in elicito's BART case study.

[font_size=18][b][color=#1f2a44]Statistical model[/color][/b][/font_size]
[center][img width=760]res://case_studies/bart/model.png[/img][/center]

[ul]
[color=#a8540f]ω is the plan:[/color] the number of pumps the participant considers best. It depends only on γ⁺.
[color=#a8540f]β sets how strictly the plan is followed:[/color] well below ω they almost surely pump, past ω they almost surely stop; large β makes this switch sharp.
[/ul]"
personas_intro = "This tab introduces expert knowledge elicitation through three training personas which differ mainly in how much risk they take. They are introduced in the following three cards:"
personas_text = "Each persona creates an expectation regarding their risk attitude as well as their uncertainty (plan consistency). This knowledge can be used to inform our statistical model by asking the following two questions:

[indent]• [color=#a8540f]How many times does a person plan to pump?[/color]
[indent]This question refers to the risk attitude of a person and maps onto ω in the statistical model.[/indent]

• [color=#a8540f]How many times does a person actually pump?[/color]
[indent]This takes the uncertainty of a person into account. When a person is highly uncertain, for example, we will see larger variation than originally planned, while a person who sticks strongly to their plan will probably deviate less from the planned pumps. This information will map onto [i]m[/i] in the statistical model.[/indent][/indent]
"
parameter_labels = {
"beta": "β consistency",
"gammap": "γ⁺ risk propensity"
}
targets = Array[ExtResource("2_target")]([SubResource("Resource_5a2fq"), SubResource("Resource_ircif")])
personas = Array[ExtResource("3_persona")]([ExtResource("4_cautious"), ExtResource("5_realistic"), ExtResource("6_risky")])
precompute_personas = Array[ExtResource("3_persona")]([ExtResource("9_uncertain"), ExtResource("10_bold"), ExtResource("11_impulsive")])
predictions_scene = ExtResource("7_predictions")
precomputed_fits = "res://case_studies/bart/precomputed/fits.json"
