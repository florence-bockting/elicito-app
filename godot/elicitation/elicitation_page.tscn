[node name="ElicitationPage" type="HBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_page")
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="LeftScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
horizontal_scroll_mode = 0

[node name="LeftMargin" type="MarginContainer" parent="LeftScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_right = 12

[node name="Left" type="VBoxContainer" parent="LeftScroll/LeftMargin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="TextBox" type="VBoxContainer" parent="LeftScroll/LeftMargin/Left"]
layout_mode = 2
theme_override_constants/separation = 22

[node name="Intro" type="RichTextLabel" parent="LeftScroll/LeftMargin/Left/TextBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/default_color = Color(0.23, 0.23, 0.23, 1)
theme_override_font_sizes/normal_font_size = 15
theme_override_font_sizes/bold_font_size = 15
bbcode_enabled = true
fit_content = true

[node name="RouletteHelp" type="FoldableContainer" parent="LeftScroll/LeftMargin/Left/TextBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.12156863, 0.16470589, 0.26666668, 1)
theme_override_colors/hover_font_color = Color(0.12156863, 0.16470589, 0.26666668, 1)
theme_override_colors/collapsed_font_color = Color(0.12156863, 0.16470589, 0.26666668, 1)
theme_override_styles/title_panel = SubResource("StyleBox_fold")
theme_override_styles/title_hover_panel = SubResource("StyleBox_fold_hover")
theme_override_styles/title_collapsed_panel = SubResource("StyleBox_fold")
theme_override_styles/title_collapsed_hover_panel = SubResource("StyleBox_fold_hover")
theme_override_styles/panel = SubResource("StyleBox_fold_panel")
title = "Practice the roulette task (about 2 minutes)"

[node name="RouletteTutorial" parent="LeftScroll/LeftMargin/Left/TextBox/RouletteHelp" instance=ExtResource("4_tutorial")]
unique_name_in_owner = true
layout_mode = 2

[node name="StepsText" type="RichTextLabel" parent="LeftScroll/LeftMargin/Left/TextBox"]
