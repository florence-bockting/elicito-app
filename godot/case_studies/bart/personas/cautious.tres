[resource]
script = ExtResource("1_yggb8")
gammap_low = 0.1
gammap_high = 0.35
beta_low = 0.2
beta_high = 0.6
display_name = "Cautious expert"
briefing = "You have run the BART with hesitant, cautious participants like Mila for years. They plan only one or two pumps, and they don't stick to that plan reliably: in about half of the trials they cash in without pumping at all, and they almost never go past two pumps. Few of their balloons pop (about one in eight)."
color = Color(0.2901961, 0.5647059, 0.7607843, 1)
character_name = "Mila"
tagline = "Avoids risk and is uncertain"
profile = "[color=#a8540f]Risk attitude: low.[/color] Mila doesn't like to take on risk and avoids losing money she already earned. She plans to pump one or two times.
[color=#a8540f]Consistency: low.[/color] Mila is hesitant and her decisions are uncertain. In about half of her trials she doesn't pump at all; in others she pumps once more than she meant to."
portrait = ExtResource("1_ti2lb")
