[resource]
script = ExtResource("1_0gwwa")
display_name = "Risk-taking expert"
briefing = "You study strategic thrill-seekers like Jonas. They plan big, 7 to 12 pumps, and they stick to that plan. But about three out of four of their balloons pop on the way, so a single trial usually ends somewhere between 2 and 7 pumps."
character_name = "Jonas"
tagline = "Takes big risks and sticks strictly to his plan"
profile = "[b]Risk attitude: high.[/b] Jonas wants the big payout and plans 7 to 12 pumps.
[b]Consistency: high.[/b] He follows his plan like a checklist: when the balloon survives, he stops within one pump of his plan in seven out of ten trials. But it usually doesn't survive: about three out of four of his balloons pop on the way."
portrait = ExtResource("1_uw47l")
gammap_low = 1.0
gammap_high = 2.0
beta_low = 2.0
beta_high = 4.0
color = Color(0.8980392, 0.3764706, 0.30980393, 1)
