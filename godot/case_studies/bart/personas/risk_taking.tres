display_name = "Risk-taking expert"
briefing = "You study strategic thrill-seekers like Jonas. They plan big, 7 to 12 pumps, and they stick to that plan. But about three out of four of their balloons pop on the way, so a single trial usually ends somewhere between 2 and 7 pumps."
color = Color(0.8980392, 0.3764706, 0.30980393, 1)
character_name = "Jonas"
tagline = "Takes big risks and sticks strictly to his plan"
profile = "[color=#a8540f]Risk attitude: high.[/color] Jonas wants the big payout and plans 7 to 12 pumps.
[color=#a8540f]Consistency: high.[/color] He follows his plan like a checklist: when the balloon survives, he stops within one pump of his plan in seven out of ten trials. "
