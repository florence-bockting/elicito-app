[gd_scene format=3]

[ext_resource type="Script" path="res://gallery/gallery.gd" id="1_gallery"]

[node name="Gallery" type="ScrollContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0
script = ExtResource("1_gallery")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Intro" type="Label" parent="VBox"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.23, 0.23, 0.23, 1)
text = "Each case study is a statistical model from the elicito documentation. Answer a few questions about what you expect to see, as yourself or as a training persona, and elicito turns the answers into a prior distribution for the model's parameters."
autowrap_mode = 3

[node name="Cards" type="HFlowContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
