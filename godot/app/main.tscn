[gd_scene format=3]

[ext_resource type="Script" path="res://app/main.gd" id="1_main"]
[ext_resource type="Resource" path="res://case_studies/catalog.tres" id="2_catalog"]
[ext_resource type="Script" path="res://net/elicito_client.gd" id="3_client"]
[ext_resource type="Script" path="res://common/settings_dialog.gd" id="4_settings"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")
catalog = ExtResource("2_catalog")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.96, 0.95, 0.92, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BackButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "← All case studies"

[node name="Title" type="Label" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.12, 0.16, 0.27, 1)
theme_override_font_sizes/font_size = 24
text = "elicito app"

[node name="OfflineButton" type="Button" parent="Margin/VBox/Header"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "No elicito server is running. Show fits that were made in advance with elicito instead."
text = "Use precomputed fits"

[node name="Status" type="Label" parent="Margin/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
text = "connecting…"

[node name="Content" type="MarginContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Client" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("3_client")
auto_connect = false

[node name="SettingsDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
script = ExtResource("4_settings")
